#!/bin/sh
# ghost-update -- get the latest ghost and install it, with the options you chose the first time (`ghost update`).
#
# The Hermes release the engine is built on is pinned in the source (engine.pin), so a newer engine arrives
# here too, once ghost's patches have been checked against it.
set -e
export GHOST_HOME=__GHOST_HOME__ GHOST_ENGINE=__ENG__

# The source you installed from, or ghost's own copy.
SRC="$(cat "$GHOST_HOME/.src" 2>/dev/null || true)"
MANAGED="$HOME/.ghost-src"
[ -d "$SRC/.git" ] || SRC="$MANAGED"

if [ ! -d "$SRC/.git" ]; then
  rm -rf "$SRC"
  git clone --quiet https://github.com/OpenGradient/ghost.git "$SRC"
elif [ "$SRC" = "$MANAGED" ]; then   # always the released branch, whatever was checked out before
  git -C "$SRC" fetch --quiet origin main
  git -C "$SRC" checkout --quiet main && git -C "$SRC" merge --quiet --ff-only origin/main || {
    echo "Your copy of ghost in $SRC has changes of yours in it, so it wasn't updated." >&2
    echo "Set them aside (git -C $SRC stash) and run this again." >&2
    exit 1
  }
else
  git -C "$SRC" pull --quiet --ff-only
fi
exec bash "$SRC/install.sh"
