#!/usr/bin/env bash
# ghost-uninstall -- remove ghost from this machine (`ghost uninstall`).
#
#   ghost uninstall             ask first, and keep your chats, skills and settings unless you say otherwise
#   ghost uninstall --yes       don't ask (your data is kept)
#   ghost uninstall --purge     delete your data too
set -uo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_NAMESPACE   # some other repository's

GHOST_HOME=__GHOST_HOME__
ENG=__ENG__
BIN="$HOME/.local/bin"
SRC="$(cat "$GHOST_HOME/.src" 2>/dev/null || true)"

YES="" PURGE=""
for arg in "$@"; do
  case "$arg" in
    --yes|-y) YES=1 ;;
    --purge)  PURGE=1 ;;
    *) echo "usage: ghost uninstall [--yes] [--purge]" >&2; exit 2 ;;
  esac
done

ask() {   # ask "question": true on yes; false on no, Enter or no terminal
  local answer=""
  [ -t 0 ] || return 1
  printf '%s [y/N] ' "$1"; read -r answer || true
  case "$answer" in [Yy]*) return 0 ;; *) return 1 ;; esac
}

# Only ever delete directories that are unmistakably ghost's.
ours_engine() {
  grep -q '"distribution": "ghost"' "$1/install-stamp.json" 2>/dev/null \
    || { [ -x "$1/venv/bin/hermes" ] && grep -qs 'Ghost v' "$1/hermes_cli/banner.py" "$1/hermes_cli/main.py"; }
}
ours_home() { [ -f "$1/.src" ] && [ -d "$1/privacy" ]; }

if ! ours_home "$GHOST_HOME"; then
  echo "ghost isn't installed here ($GHOST_HOME)."
  exit 0
fi

REAL="$(cd "$ENG" 2>/dev/null && pwd -P || echo "$ENG")"
open="$( (ps axww -o pid=,command= 2>/dev/null || true) | awk -v e="$ENG" -v r="$REAL" \
  '(index($0, e "/") || index($0, e "\047") || index($0, r "/") || index($0, r "\047")) && !/gateway run|process_supervisor/ { print $1 }')"
if [ -n "$open" ] && [ -z "${GHOST_FORCE:-}" ]; then
  echo "ghost is open (pid $(echo $open)). Close those windows and run this again." >&2
  exit 1
fi

echo "This removes ghost: its engine ($ENG), background services and commands."
if [ -z "$YES" ]; then
  ask "Remove ghost?" || { echo "Nothing was changed."; exit 0; }
  [ -n "$PURGE" ] || ! ask "Also delete your chats, skills, settings and login?" || PURGE=1
fi

echo "Stopping ghost"
UNIT="$HOME/Library/LaunchAgents/ai.hermes.gateway-uncensored.plist"
[ -f "$UNIT" ] || UNIT="$HOME/.config/systemd/user/hermes-gateway-uncensored.service"
GATEWAY=""; if [ -f "$UNIT" ] && grep -qF -e "$ENG/" -e "$GHOST_HOME/" "$UNIT"; then GATEWAY=1; fi
if [ -x "$ENG/.hermes/bin/hermes" ]; then
  engine() { HERMES_HOME="$GHOST_HOME" "$ENG/.hermes/bin/hermes" -p uncensored "$@" </dev/null >/dev/null 2>&1; }
  engine gateway stop --yes || engine gateway stop
  [ -z "$GATEWAY" ] || engine gateway uninstall
fi
if [ -n "$GATEWAY" ] && [ -f "$UNIT" ]; then   # (the engine couldn't)
  case "$UNIT" in
    *.plist) launchctl bootout "gui/$(id -u)/ai.hermes.gateway-uncensored" >/dev/null 2>&1 ;;
    *)       systemctl --user disable --now hermes-gateway-uncensored.service >/dev/null 2>&1 ;;
  esac
  rm -f "$UNIT"
fi
if [ "$(uname -s)" = Darwin ]; then
  for label in ai.dreamfort.ghost com.advait.hermes-pii-scrubber com.advait.hermes-veil; do
    plist="$HOME/Library/LaunchAgents/$label.plist"
    [ -f "$plist" ] || continue
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || launchctl unload "$plist" >/dev/null 2>&1
    rm -f "$plist"
  done
else
  for unit in ghost-bridge ghost-scrubber ghost-veil; do
    systemctl --user disable --now "$unit.service" >/dev/null 2>&1
    rm -f "$HOME/.config/systemd/user/$unit.service"
  done
  systemctl --user daemon-reload >/dev/null 2>&1
fi
# One `ghost` started itself, where there is no service manager.
pid="$(curl --noproxy '*' -s -D - -o /dev/null --max-time 2 http://127.0.0.1:8788/healthz | tr -d '\r' | sed -n 's/^X-Ghost-Pid: \([0-9]*\)$/\1/p')"
if [ -n "$pid" ]; then
  case "$(ps -ww -o command= -p "$pid" 2>/dev/null || tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
    *"$GHOST_HOME/privacy/"*) kill "$pid" 2>/dev/null ;;
  esac
fi

if [ "$(uname -s)" = Darwin ]; then   # the gateway a chat started leaves its entry behind
  for label in $(launchctl list | awk '/com[.]nousresearch[.]hermes[.]runtime[.]/ { print $3 }'); do
    case "$(launchctl print "gui/$(id -u)/$label" 2>/dev/null)" in *"path = $GHOST_HOME/"*) launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 ;; esac
  done
fi

echo "Removing files"
for dir in "$ENG" "$ENG.old" "$ENG.new"; do
  if [ -d "$dir" ]; then
    if ours_engine "$dir"; then rm -rf "$dir"; else echo "   left $dir (not an engine ghost built)"; fi
  fi
done
for name in ghost ghost-login ghost-update; do
  if grep -qs GHOST_HOME "$BIN/$name"; then rm -f "$BIN/$name"; fi
done
if [ -e "$BIN/ghost.other" ] && [ ! -e "$BIN/ghost" ]; then mv "$BIN/ghost.other" "$BIN/ghost"; fi   # what had the name before
for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
  if grep -qs '\.local/bin.*  # ghost$' "$rc"; then   # the line the installer put there
    rest="$(grep -v '\.local/bin.*  # ghost$' "$rc")"; printf '%s\n' "$rest" > "$rc"
  fi
done
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/ghost.fish"
if [ "$SRC" = "$HOME/.ghost-src" ] && [ -d "$SRC/.git" ]; then
  yours() { git -C "$SRC" status --porcelain; git -C "$SRC" stash list; git -C "$SRC" log --oneline --branches --not --remotes; }
  if [ -z "$(yours 2>/dev/null)" ]; then rm -rf "$SRC"; else echo "   left $SRC (it has changes of yours)"; fi
fi
[ ! -e "$GHOST_HOME/.linger" ] || loginctl disable-linger "$(id -un)" >/dev/null 2>&1
! grep -qs GHOST_LOCAL "$GHOST_HOME/.install-env" || echo "   left the offline model in Ollama (ollama rm ghost-tool uncensored-local)"
if [ -n "$PURGE" ]; then
  rm -f "${OG_VEIL_HOME:-$HOME/.opengradient/veil}/session.json"
  find "$GHOST_HOME" -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} +   # (the Ghost blog's command keeps its own file there)
  rmdir "$GHOST_HOME" 2>/dev/null
  [ -d "$HOME/.hermes" ] || rm -rf "$HOME/.local/state/hermes/gateway-locks"; rmdir "$HOME/.local/state/hermes" 2>/dev/null
  echo "ghost and all of its data are gone."
else
  for dir in venv tools installs cache python uv privacy/__pycache__; do rm -rf "${GHOST_HOME:?}/$dir"; done
  rm -f "$GHOST_HOME/.src" "$GHOST_HOME/.install-env" "$GHOST_HOME/.linger" "$GHOST_HOME/install.log" "$GHOST_HOME"/privacy/*.py \
        "$GHOST_HOME/privacy/uncensored_prefill.json" "$GHOST_HOME/privacy/bridge.key" "$GHOST_HOME/privacy/.made" \
        "$GHOST_HOME/privacy/proxies.json" "$GHOST_HOME"/privacy/bridge.log*
  echo "ghost is gone. Your chats, skills, settings and login are still in $GHOST_HOME (delete it to remove them too)."
fi
rm -f "$BIN/ghost-uninstall"
